# PORT: HTTP port for `npm run dev` (Express + Vite). Defaults to 3000 if unset.
# PORT=3002

# DEEPSEEK_API_KEY: Used only on the dev/prod Node server. Never sent to the browser.
# Required for chat streaming and auto-titled chats.
# Copy to .env.local (recommended) or .env; server loads .env then .env.local (local overrides).
DEEPSEEK_API_KEY=""
# Optional OpenAI-compatible endpoint and model overrides.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenPencil design canvas. It reuses DEEPSEEK_API_KEY through the server-side
# Clyra adapter; no second provider key is required or sent to the browser.
# OPENPENCIL_HOST=127.0.0.1
# OPENPENCIL_PORT=3100
# OPENPENCIL_URL=http://127.0.0.1:3100
# OPENPENCIL_MODEL=deepseek-v4-flash
# OPENPENCIL_MAX_CONCURRENCY=1

# Voice call: Pipecat + SmallWebRTCTransport, Fish Audio STT/TTS, DeepSeek LLM.
# The Python worker (backend/voice-pipeline) is auto-started by the Node
# server; tools/setup-voice.sh builds its venv.
# VOICE_ENABLED=true
# VOICE_PIPELINE_URL=http://127.0.0.1:8787
# VOICE_SAMPLE_RATE=16000
# Fish Audio — server-side only. Never prefix these with VITE_.
# FISH_AUDIO_API_KEY=
# FISH_TTS_REFERENCE_ID=
# FISH_TTS_MODEL=s1

# Camera / screen vision — Gemini only (Ollama removed). Set on Clyra server.
GEMINI_API_KEY=""
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Creator Fake Text Story voices. FISH_TTS_REFERENCE_ID is the voice named by
# FISH_TTS_BASE_VOICE_NAME (Max by default); it is intentionally not reused for
# every character. Map any additional, approved provider voices explicitly so
# grey incoming and blue outgoing messages have genuinely different audio.
# CREATOR_TTS_VOICE_RYAN_ID=provider-voice-id-for-ryan
# CREATOR_TTS_VOICE_AIDEN_ID=provider-voice-id-for-aiden
# Or use a JSON mapping: CREATOR_TTS_VOICE_IDS_JSON={"Ryan":"...","Aiden":"..."}
# On macOS, unconfigured Creator names safely fall back to distinct local
# system voices. Set this to false to require explicit hosted voice mappings.
# CREATOR_TTS_ALLOW_SYSTEM_FALLBACK=true

# Google Desktop OAuth — Electron main process only. Keep these empty here.
CLYRA_GOOGLE_CLIENT_ID=
CLYRA_GOOGLE_CLIENT_SECRET=
