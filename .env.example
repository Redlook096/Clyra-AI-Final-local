# PORT: HTTP port for `npm run dev` (Express + Vite). Defaults to 3000 if unset.
# PORT=3002

# DEEPSEEK_API_KEY: Used only on the dev/prod Node server. Never sent to the browser.
# Required for chat streaming and auto-titled chats.
# Copy to .env.local (recommended) or .env; server loads .env then .env.local (local overrides).
DEEPSEEK_API_KEY=""
# Optional OpenAI-compatible endpoint and model overrides.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenPencil design canvas. It reuses DEEPSEEK_API_KEY through the server-side
# Clyra adapter; no second provider key is required or sent to the browser.
# OPENPENCIL_HOST=127.0.0.1
# OPENPENCIL_PORT=3100
# OPENPENCIL_URL=http://127.0.0.1:3100
# OPENPENCIL_MODEL=deepseek-v4-flash
# OPENPENCIL_MAX_CONCURRENCY=1

# LiveKit (optional — enables WebRTC transport)
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Voice pipeline worker (Faster-Whisper streaming + one persistent official
# Chatterbox-Turbo model shared by voice calls and creator narration).
# VOICE_ENABLED=true
# VOICE_PIPELINE_URL=http://127.0.0.1:8787
# VOICE_STT_MODEL=tiny.en
# VOICE_STT_LANGUAGE=en
# VOICE_WHISPER_DEVICE=cpu
# VOICE_WHISPER_COMPUTE=int8
# VOICE_TTS_VOICE=Ryan
# VOICE_TTS_ENGINE=chatterbox-turbo
# VOICE_TTS_REFERENCE=/absolute/path/to/consented-voice-reference.wav
# VOICE_TTS_ALLOW_FALLBACK=false
# VOICE_SAMPLE_RATE=16000
# VOICE_ENDPOINT_SILENCE_MS=420
# VOICE_TTS_TIMEOUT_MS=30000

# Async Voice API — server-side only. Never prefix these with VITE_.
# ASYNC_API_KEY=sk_...
# ASYNC_VOICE_ID=317bf805-4b42-417b-9474-10807e2f67c9 # Max
# Async Flash is the default low-latency model. Use only models enabled for your account.
# ASYNC_TTS_MODEL=async_flash_v1.5
# ASYNC_TTS_FALLBACK_MODEL=async_flash_v1.5
# ASYNC_TTS_SAMPLE_RATE=44100
# Async ASR is on by default whenever ASYNC_API_KEY is set. Set false to force local Whisper.
# ASYNC_STT_ENABLED=true
# ASYNC_STT_MODEL=async_asr_v1.0

# Camera / screen vision — Gemini preferred for voice-call camera frames.
# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-2.0-flash
# OPENCLUELY_VISION_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Creator Fake Text Story voices. ASYNC_VOICE_ID is the voice named by
# ASYNC_VOICE_NAME (Max by default); it is intentionally not reused for every
# character. Map any additional, approved provider voices explicitly so grey
# incoming and blue outgoing messages have genuinely different audio.
# CREATOR_TTS_VOICE_RYAN_ID=provider-voice-id-for-ryan
# CREATOR_TTS_VOICE_AIDEN_ID=provider-voice-id-for-aiden
# Or use a JSON mapping: CREATOR_TTS_VOICE_IDS_JSON={"Ryan":"...","Aiden":"..."}
# On macOS, unconfigured Creator names safely fall back to distinct local
# system voices. Set this to false to require explicit hosted voice mappings.
# CREATOR_TTS_ALLOW_SYSTEM_FALLBACK=true

# Google Desktop OAuth — Electron main process only. Keep these empty here.
CLYRA_GOOGLE_CLIENT_ID=
CLYRA_GOOGLE_CLIENT_SECRET=
