FROM python:3.11-slim

WORKDIR /app

COPY requirements-voice.txt /app/requirements-voice.txt
RUN pip install --no-cache-dir -r /app/requirements-voice.txt

COPY backend/voice-pipeline /app/backend/voice-pipeline

ENV PIPELINE_PORT=8787
ENV VOICE_SAMPLE_RATE=16000

WORKDIR /app/backend/voice-pipeline
EXPOSE 8787

CMD ["python", "main.py"]
